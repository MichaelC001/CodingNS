{
  "name": "host",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "pnpm --dir ../../packages/session-sync-core build && pnpm --dir ../../packages/relay-tunnel-wire build",
    "prebuild": "pnpm --dir ../../packages/session-sync-core build && pnpm --dir ../../packages/relay-tunnel-wire build",
    "pretest": "pnpm --dir ../../packages/session-sync-core build && pnpm --dir ../../packages/relay-tunnel-wire build",
    "dev": "npm run dev:watch",
    "dev:watch": "tsx watch --clear-screen=false --include \"../../packages/session-sync-core/dist/**/*.js\" src/main.ts",
    "build": "node scripts/build.mjs",
    "test": "node scripts/run-vitest.mjs",
    "test:all": "pnpm exec vitest run",
    "test:related": "pnpm exec vitest related",
    "test:changed": "pnpm exec vitest --changed"
  },
  "dependencies": {
    "@codingns/relay-tunnel-wire": "workspace:*",
    "@codingns/session-sync-core": "workspace:*",
    "libsql": "^0.5.29",
    "chokidar": "^5.0.0",
    "fastify": "^5.8.2",
    "ignore": "^7.0.5",
    "@lydell/node-pty": "^1.1.0",
    "playwright-core": "^1.54.2",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "werift": "^0.24.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
